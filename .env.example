# ─────────────────────────────────────────────────────────────
#  Kaizenext Brain Battle — frontend environment
#  Copy to `.env` (or `.env.local`) for local dev, and add the same
#  keys in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase PUBLISHABLE key (sb_publishable_…). It is designed to be public:
# all sensitive data is protected by RLS + the quiz-api Edge Function.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional: public URL encoded in QR codes (defaults to the browser origin).
VITE_SITE_URL=

# Optional (development only): use the local in-browser demo backend even
# when Supabase keys are present. Ignored in production builds.
VITE_FORCE_DEMO=false

# ⚠️  NEVER put the Supabase secret / service-role key here.
#     Anything prefixed with VITE_ is shipped to every browser.
#     The service-role key exists only inside Supabase Edge Functions,
#     where Supabase injects it automatically.
